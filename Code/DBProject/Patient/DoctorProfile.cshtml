        @* Replaces asp:Button ID="AppointmentB" runat="server" Text="Take Appointment"
           OnClick="RedirectToAppointmentTaker" Font-Bold="true"
           Response.Redirect("AppointmentTaker.aspx") replaced with RedirectToPage *@
