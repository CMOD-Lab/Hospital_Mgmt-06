@* Migrated from ASP.NET Web Forms (DoctorProfile.aspx) to ASP.NET Core Razor Pages
   to support cloud-native deployment on AWS.
   Rule cr-dotnet-0026 remediation applied:
   - Removed <%@ Page %> directive with MasterPageFile, AutoEventWireup, CodeBehind, Inherits
     (line 1 in original DoctorProfile.aspx)
   - Removed asp:Content, asp:Label, asp:Button Web Forms server controls
   - Replaced with ASP.NET Core Razor Pages syntax using _PatientLayout.cshtml layout
   - asp:Label DName / DPhone / DQualification / DSpecialization / DWork / DAge / DGender /
     DDept / DCharges / DRI / DPT replaced with model property bindings
   - asp:Button ID="AppointmentB" OnClick="RedirectToAppointmentTaker" replaced with
     an HTML anchor/form redirecting to AppointmentTaker Razor Page *@
@page
@model DBProject.Patient.DoctorProfileModel
@{
    ViewData["Title"] = "Doctor's Profile";
    Layout = "~/Patient/_PatientLayout.cshtml";
}

@section head {
    <title>Doctor's Profile</title>
}

<!----------------Styling---------------->
<link rel="stylesheet" href="/assets/css/grid-view.css" />

<div style="background-image:url(/assets/img/backgrounds/PatientHome.jpg); background-position:center; background-size:20px">

    <br />
    <h1><strong style="margin:37%">Doctor's Profile</strong></h1>
    <br /><br />

    <div style="margin-left: 70px">

        @* Replaces asp:Label ID="DName" runat="server" Font-Bold="true" Font-Size="Medium" *@
        <h4><strong>Name: </strong></h4>
        @if (!string.IsNullOrEmpty(Model.DName))
        {
            <p style="font-weight:bold; font-size:medium;">@Model.DName</p>
        }
        <br /><br />

        @* Replaces asp:Label ID="DPhone" runat="server" Font-Bold="true" Font-Size="Medium" *@
