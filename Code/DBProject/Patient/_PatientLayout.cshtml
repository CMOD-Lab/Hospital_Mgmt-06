@* Migrated from ASP.NET Web Forms Master Page (PatientMaster.Master / PatientMaster.Master.cs)
   to ASP.NET Core Razor Pages Layout to support cloud-native deployment on AWS.
   Rule cr-dotnet-0026 remediation applied:
   - Removed <%@ Master %> directive (line 1 in original PatientMaster.Master)
   - Removed System.Web.UI.MasterPage, ContentPlaceHolder, and runat="server" dependencies
     which are not available in ASP.NET Core.
   - Removed <form id="form1" runat="server"> wrapper (not needed in ASP.NET Core)
   - asp:ContentPlaceHolder ID="head" replaced with @RenderSection("head", required: false)
   - asp:ContentPlaceHolder ID="ContentPlaceHolder1" replaced with @RenderBody()
   - Navigation links updated from *.aspx to Razor Pages routes (/Patient/*) *@
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    @* Styling *@

    @* Google Fonts *@
    <link href='https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700|Lato:400,100,300,700,900' rel='stylesheet' type='text/css' />

    @* Latest compiled and minified CSS *@
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css"
          integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u"
          crossorigin="anonymous" />

    @* Patient Style *@
    <link rel="stylesheet" href="/assets/css/patient-style.css" />

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.4/jquery.min.js"></script>

    @* Styling for Footer *@
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="keywords" content="footer, address, phone, icons" />

    <link rel="stylesheet" href="/assets/css/demo.css" />
    <link rel="stylesheet" href="/assets/css/footer-distributed-with-address-and-phones.css" />

    <link rel="stylesheet" href="http://maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" />
    <link href="http://fonts.googleapis.com/css?family=Cookie" rel="stylesheet" type="text/css" />

    <title>@ViewData["Title"]</title>

    @* Render additional head content from pages (replaces asp:ContentPlaceHolder ID="head") *@
    @RenderSection("head", required: false)
</head>

<body>
    <div>
        @* Navigation Bar – replaces <nav> inside <form id="form1" runat="server">
           Links updated from *.aspx to Razor Pages routes *@
        <nav class="navbar navbar-inverse">
            <div class="container-fluid" style="background-color:#4c4f51">
                <ul class="nav navbar-nav navbar-right">
                    @* Replaces href="/SignUp.aspx" *@
                    <li><a href="/signup"><span class="glyphicon glyphicon-log-in"></span> Log Out</a></li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    @* Replaces href="PatientFeedback.aspx" *@
                    <li><a href="/Patient/PatientFeedback"><span class="glyphicon glyphicon-thumbs-up"></span> Feedback</a></li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    @* Replaces href="TreatmentHistory.aspx" *@
                    <li><a href="/Patient/TreatmentHistory"><span class="glyphicon glyphicon-info-sign"></span> Treatment History</a></li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    @* Replaces href="BillsHistory.aspx" *@
                    <li><a href="/Patient/BillsHistory"><span class="glyphicon glyphicon-usd"></span> Bills History</a></li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    @* Replaces href="TakeAppointment.aspx" *@
                    <li><a href="/Patient/TakeAppointment"><span class="glyphicon glyphicon-plus"></span> Take Appointment</a></li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    @* Replaces href="CurrentAppointment.aspx" *@
                    <li><a href="/Patient/CurrentAppointment"><span class="glyphicon glyphicon-search"></span> Current Appointment</a></li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    @* Replaces href="PatientNotifications.aspx" *@
                    <li><a href="/Patient/PatientNotifications"><span class="glyphicon glyphicon-flag"></span> Notifications</a></li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    @* Replaces href="PatientHome.aspx" *@
                    <li><a href="/Patient/PatientHome"><span class="glyphicon glyphicon-home"></span> Home</a></li>
                </ul>
            </div>
        </nav>
        @* Navigation Bar ends here *@

        @* Body Content (replaces asp:ContentPlaceHolder ID="ContentPlaceHolder1") *@
        @RenderBody()

    </div>

    @* Footer *@
    <footer class="footer-distributed">
        <div class="footer-left">
            <h3>MedicX<span>4</span></h3>
            <p class="footer-company-name">MedicX4 Health Care &copy; 2017</p>
        </div>

        <div class="footer-center">
            <div>
                <i class="fa fa-map-marker"></i>
                <p><span>Milaad St Block B</span> Faisal Town, Lahore</p>
            </div>
            <div>
                <i class="fa fa-phone"></i>
                <p>0322 - 7561001</p>
            </div>
            <div>
                <i class="fa fa-envelope"></i>
                <p><a href="mailto:support@medicx4.com">support@medicx4.com</a></p>
            </div>
        </div>

        <div class="footer-right">
            <p class="footer-company-about">
                <span>About the company</span>
                Our mission is to provide quality health services to all in a comfortable and cozy environment.
                The clinic primarily offers consultations and is not equipped to take emergencies.
            </p>
            <div class="footer-icons">
                <a href="#"><i class="fa fa-facebook"></i></a>
            </div>
        </div>
    </footer>
    @* Footer ends here *@
</body>
</html>
