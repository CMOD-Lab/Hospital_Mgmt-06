@* Migrated from ASP.NET Web Forms (ViewDoctors.aspx) to ASP.NET Core Razor Pages
   to support cloud-native deployment on AWS.
   Rule cr-dotnet-0026 remediation applied:
   - Removed <%@ Page %> directive with MasterPageFile, AutoEventWireup, CodeBehind, Inherits
     (line 1 in original ViewDoctors.aspx)
   - Removed asp:Content, asp:Label, asp:GridView, asp:TemplateField Web Forms server controls
   - Replaced with ASP.NET Core Razor Pages syntax using _PatientLayout.cshtml layout
   - GridView replaced with an HTML table rendered from the DataTable model property
   - asp:Label TDoctor error/info message replaced with model-bound message
   - GridView AutoGenerateSelectButton / OnRowCommand replaced with Select link to OnGetSelect handler *@
@page
@model DBProject.Patient.ViewDoctorsModel
@{
    ViewData["Title"] = "Doctors";
    Layout = "~/Patient/_PatientLayout.cshtml";
}

@section head {
    <title>Doctors</title>
}

<!----------------Styling---------------->
<link rel="stylesheet" href="/assets/css/grid-view.css" />

<h1><strong style="margin:23%">Select a Doctor to view his Profile</strong></h1>
<br /><br />

@* Replaces asp:Label ID="TDoctor" runat="server" *@
@if (!string.IsNullOrEmpty(Model.TDoctor))
{
    <p>@Model.TDoctor</p>
}
<br /><br />

@* Replaces asp:GridView ID="TDoctorGrid" with AutoGenerateSelectButton and OnRowCommand="TDoctorGrid_RowCommand" *@
@if (Model.Doctors != null && Model.Doctors.Rows.Count > 0)
{
    <table class="GridView-d" cellpadding="4" style="width:1000px; color:Black; border:1px solid #DEDFDE; border-style:None; border-width:1px;">
        <thead style="background-color:#6B696B; color:White; font-weight:bold;">
            <tr>
                @* Replaces asp:TemplateField HeaderText="No." *@
                <th style="width:50px;">No.</th>
                @foreach (System.Data.DataColumn col in Model.Doctors.Columns)
                {
                    <th>@col.ColumnName</th>
                }
                <th>Select</th>
            </tr>
        </thead>
        <tbody>
            @{ int rowNumber = 1; }
            @foreach (System.Data.DataRow row in Model.Doctors.Rows)
            {
                <tr style="background-color:#F7F7DE;">
                    @* Replaces asp:Label ID="lblRowNumber" Text='<%# Container.DataItemIndex + 1 %>' *@
                    <td style="width:50px;">@rowNumber</td>
                    @foreach (var cell in row.ItemArray)
                    {
                        <td>@cell</td>
                    }
                    <td>
                        @* Replaces GridView AutoGenerateSelectButton / OnRowCommand="TDoctorGrid_RowCommand":
                           doctor ID (Cells[2].Text equivalent) passed as query-string parameter *@
                        <a href="?handler=Select&dID=@Uri.EscapeDataString(row.ItemArray.Length > 1 ? row.ItemArray[1]?.ToString() ?? string.Empty : string.Empty)"
                           class="btn btn-sm btn-primary">Select</a>
                    </td>
                </tr>
                rowNumber++;
            }
        </tbody>
    </table>
}

<br /><br />
