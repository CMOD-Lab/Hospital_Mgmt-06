@* Migrated from ASP.NET Web Forms (PendingAppointment.aspx) to ASP.NET Core Razor Pages
   to support cloud-native deployment on AWS.
   Rule cr-dotnet-0026 remediation applied:
   - Removed <%@ Page %> directive with MasterPageFile, AutoEventWireup, CodeBehind, Inherits
     (line 1 in original PendingAppointment.aspx)
   - Removed asp:Content, asp:GridView Web Forms server controls
   - Replaced with ASP.NET Core Razor Pages syntax using _DoctorLayout.cshtml layout
   - GridView replaced with an HTML table rendered from the DataTable model property
   - Row select / delete handled via form POST handlers instead of GridView RowCommand/RowDeleting *@
@page
@model doctor.PendingAppointmentModel
@{
    ViewData["Title"] = "Pending Appointments";
    Layout = "~/Doctor/_DoctorLayout.cshtml";
}

@section head {
    <title>Pending Appointments</title>
}

<!----------------Styling---------------->
<link rel="stylesheet" href="/assets/css/grid-view.css" />

<h1><strong style="margin:25%">Pending Appointments</strong></h1>
<br /><br />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div style="margin-left:300px">
    @if (Model.PendingAppointments != null && Model.PendingAppointments.Rows.Count > 0)
    {
        <table class="GridView-d" cellpadding="4" style="color:Black; border:1px solid #DEDFDE; border-style:None; border-width:1px;">
            <thead style="background-color:#6B696B; color:White; font-weight:bold;">
                <tr>
                    @foreach (System.Data.DataColumn col in Model.PendingAppointments.Columns)
                    {
                        <th>@col.ColumnName</th>
                    }
                    <th>Select</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @{ int rowIndex = 0; }
                @foreach (System.Data.DataRow row in Model.PendingAppointments.Rows)
                {
                    <tr style="background-color:#F7F7DE;">
                        @foreach (var cell in row.ItemArray)
                        {
                            <td>@cell</td>
                        }
                        <td>
                            @* Replaces GridView AutoGenerateSelectButton / OnRowCommand="update_appointment":
                               appointment ID is in column index 1 (same as original Cells[1].Text) *@
                            <form method="post" asp-page-handler="UpdateAppointment" style="display:inline;">
                                <input type="hidden" name="appointmentId" value="@row[1]" />
                                <button type="submit" class="btn btn-sm btn-primary">Select</button>
                            </form>
                        </td>
                        <td>
                            @* Replaces GridView AutoGenerateDeleteButton / OnRowDeleting="Delete_appointment" *@
                            <form method="post" asp-page-handler="DeleteAppointment" style="display:inline;">
                                <input type="hidden" name="appointmentId" value="@row[1]" />
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                    rowIndex++;
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No pending appointments found.</p>
    }
</div>

<br /><br /><br /><br /><br />
